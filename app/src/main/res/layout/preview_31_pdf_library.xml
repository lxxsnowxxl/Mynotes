<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_screen_editor"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="30dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="18dp" android:paddingEnd="24dp" android:paddingBottom="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/preview_circle_base"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/preview_ic_arrow_back" android:tint="#111111" /></FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/pdf_library_title" android:textColor="#111111" android:textSize="28sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif" android:text="@string/pdf_library_subtitle" android:textColor="#585960" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/preview_chip_light_selected" android:gravity="center" android:fontFamily="sans-serif" android:paddingStart="11dp" android:paddingEnd="11dp" android:text="2 PDF" android:textColor="#111111" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/preview_chip_light_selected" android:gravity="center" android:fontFamily="sans-serif" android:paddingStart="11dp" android:paddingEnd="11dp" android:text="@string/pdf_library_autosave" android:textColor="#111111" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- V93: con texto automático negro, las tarjetas se aclaran para mantener contraste. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:background="@drawable/preview_light_group" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
                <FrameLayout android:layout_width="74dp" android:layout_height="98dp" android:background="@drawable/preview_pdf_page">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="7dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="PDF" android:textColor="#222222" android:textSize="8sp" />
                        <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="5dp" android:background="#D5D5D5" />
                        <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="#D5D5D5" />
                        <View android:layout_width="38dp" android:layout_height="34dp" android:layout_marginTop="8dp" android:layout_gravity="center_horizontal" android:background="#E8E8E8" />
                        <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="7dp" android:background="#D5D5D5" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:lineSpacingMultiplier="0.90" android:text="MyNotes_20260921_0451" android:textColor="#111111" android:textSize="17sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginTop="4dp" android:background="@drawable/preview_chip_light_selected" android:gravity="center" android:fontFamily="sans-serif" android:paddingStart="9dp" android:paddingEnd="9dp" android:text="2 pág." android:textColor="#111111" android:textSize="11sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif" android:text="Editado: 21 sept. 2026 5:26" android:textColor="#5D5E64" android:textSize="11sp" />
                </LinearLayout>
                <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/preview_circle_base"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/preview_ic_more" android:tint="#111111" /></FrameLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="12dp" android:background="@drawable/preview_light_group" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
                <FrameLayout android:layout_width="74dp" android:layout_height="98dp" android:background="@drawable/preview_pdf_page">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="7dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="PDF" android:textColor="#222222" android:textSize="8sp" />
                        <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="5dp" android:background="#D5D5D5" />
                        <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="4dp" android:background="#D5D5D5" />
                        <View android:layout_width="38dp" android:layout_height="34dp" android:layout_marginTop="8dp" android:layout_gravity="center_horizontal" android:background="#E8E8E8" />
                        <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="7dp" android:background="#D5D5D5" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:lineSpacingMultiplier="0.90" android:text="Apuntes editables" android:textColor="#111111" android:textSize="17sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginTop="4dp" android:background="@drawable/preview_chip_light_selected" android:gravity="center" android:fontFamily="sans-serif" android:paddingStart="9dp" android:paddingEnd="9dp" android:text="4 pág." android:textColor="#111111" android:textSize="11sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif" android:text="Editado: 22 sept. 2026 17:31" android:textColor="#5D5E64" android:textSize="11sp" />
                </LinearLayout>
                <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/preview_circle_base"><ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/preview_ic_more" android:tint="#111111" /></FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/preview_button_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="17dp">
        <ImageView android:layout_width="21dp" android:layout_height="21dp" android:src="@drawable/preview_ic_add" android:tint="#FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:fontFamily="sans-serif" android:text="@string/pdf_library_new" android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
