<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layout_xml_screen"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    tools:ignore="HardcodedText,ContentDescription"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    android:id="@+id/preview_32_pdf_editor_empty_linearlayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/preview_32_pdf_editor_empty_linearlayout_1">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/preview_ic_arrow_back"
            android:tint="@color/layout_xml_text"
            android:id="@+id/preview_32_pdf_editor_empty_imageview_2" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:id="@+id/preview_32_pdf_editor_empty_linearlayout_3">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_studio"
                android:textColor="@color/layout_xml_text"
                android:textSize="27sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_4" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_studio_subtitle"
                android:textColor="@color/layout_xml_text"
                android:textSize="13sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_5" />
        </LinearLayout>
        <TextView
            android:layout_width="128dp"
            android:layout_height="52dp"
            android:background="@drawable/preview_button_dark"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="@string/pdf_export"
            android:textColor="@color/layout_xml_text"
            android:textSize="14sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_32_pdf_editor_empty_textview_6" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="290dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group"
        android:elevation="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:id="@+id/preview_32_pdf_editor_empty_linearlayout_7">
        <TextView
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/preview_button_light"
            android:gravity="center"
            android:text="↶"
            android:textColor="@color/layout_xml_text"
            android:textSize="21sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_32_pdf_editor_empty_textview_8" />
        <TextView
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/preview_button_light"
            android:gravity="center"
            android:text="↷"
            android:textColor="@color/layout_xml_text"
            android:textSize="21sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_32_pdf_editor_empty_textview_9" />
        <TextView
            android:layout_width="30dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/layout_xml_text"
            android:textSize="22sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_32_pdf_editor_empty_textview_10" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/preview_chip_light_selected"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="#  Página 1 de 1"
            android:textColor="@color/layout_xml_text"
            android:textSize="12sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_32_pdf_editor_empty_textview_11" />
        <TextView
            android:layout_width="30dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/layout_xml_text"
            android:textSize="22sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_32_pdf_editor_empty_textview_12" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="@drawable/preview_pdf_page"
        android:id="@+id/preview_32_pdf_editor_empty_framelayout_13">
        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/preview_button_light"
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/preview_32_pdf_editor_empty_linearlayout_14">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/preview_ic_file"
                android:tint="@color/layout_xml_text"
                android:id="@+id/preview_32_pdf_editor_empty_imageview_15" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_open_pdf"
                android:textColor="@color/layout_xml_text"
                android:textSize="14sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_16" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/preview_light_group"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="15dp"
            android:paddingEnd="52dp"
            android:paddingBottom="15dp"
            android:id="@+id/preview_32_pdf_editor_empty_linearlayout_17">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_test_mode_title"
                android:textColor="@color/layout_xml_text"
                android:textSize="18sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_18" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:text="@string/pdf_test_mode_description"
                android:textColor="@color/layout_xml_text"
                android:textSize="13sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_19" />
        </LinearLayout>
        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center|end"
            android:layout_marginEnd="34dp"
            android:layout_marginBottom="154dp"
            android:background="@drawable/preview_surface_dark"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/layout_xml_text"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_32_pdf_editor_empty_textview_20" />
    </FrameLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group"
        android:scrollbars="none"
        android:id="@+id/preview_32_pdf_editor_empty_horizontalscrollview_21">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:id="@+id/preview_32_pdf_editor_empty_linearlayout_22">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/preview_small_selected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_select"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_23" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_draw"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_24" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_highlighter"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_25" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_text"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_26" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_add_image"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_32_pdf_editor_empty_textview_27" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
