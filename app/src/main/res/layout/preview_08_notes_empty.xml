<?xml version="1.0" encoding="utf-8"?>
<!-- v312: editable design reference; production screen is implemented in Compose. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_xml_app_background"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    tools:ignore="HardcodedText,ContentDescription"
    android:id="@+id/preview_08_notes_empty_framelayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:id="@+id/preview_08_notes_empty_linearlayout_1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:id="@+id/preview_08_notes_empty_linearlayout_2">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:id="@+id/preview_08_notes_empty_linearlayout_3">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mock_my_notes"
                    android:textSize="30sp"
                    android:textColor="@color/layout_xml_text"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:id="@+id/preview_08_notes_empty_textview_4" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mock_notes_subtitle"
                    android:textSize="14sp"
                    android:textColor="@color/layout_xml_secondary"
                    android:fontFamily="sans-serif"
                    android:textStyle="normal"
                    android:layout_marginTop="1dp"
                    android:id="@+id/preview_08_notes_empty_textview_5" />
            </LinearLayout>
            <android.widget.ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/preview_ic_person"
                android:contentDescription="@null"
                android:background="@drawable/layout_xml_tone"
                android:padding="12dp"
                android:id="@+id/preview_08_notes_empty_imageview_6" />
            <android.widget.ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/preview_ic_settings"
                android:background="@android:color/transparent"
                android:padding="12dp"
                android:id="@+id/preview_08_notes_empty_open_settings"
                android:contentDescription="@string/mock_settings"
                android:tint="@color/layout_xml_text" />
        </LinearLayout>
        <Space
            android:layout_width="1dp"
            android:layout_height="14dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/layout_xml_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:id="@+id/preview_08_notes_empty_linearlayout_9">
            <android.widget.ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/preview_ic_search"
                android:contentDescription="@null"
                android:tint="@color/layout_xml_text"
                android:id="@+id/preview_08_notes_empty_imageview_10" />
            <EditText
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:id="@+id/preview_08_notes_empty_search"
                android:hint="@string/mock_search_notes"
                android:text=""
                android:background="@null"
                android:textColor="@color/layout_xml_text"
                android:textColorHint="@color/layout_xml_secondary"
                android:textSize="16sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:inputType="text" />
        </LinearLayout>
        
        <Space
            android:layout_width="1dp"
            android:layout_height="10dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:id="@+id/preview_08_notes_empty_view_controls">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/design_section_notes"
                android:textSize="14sp"
                android:textColor="@color/layout_xml_text"
                android:layout_weight="1" />
            <android.widget.ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/layout_xml_design_list"
                android:contentDescription="@string/design_show_list"
                android:padding="12dp"
                android:tint="@color/layout_xml_text"
                android:background="@android:color/transparent" />
            <android.widget.ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/layout_xml_design_density"
                android:contentDescription="@string/design_use_compact"
                android:padding="12dp"
                android:tint="@color/layout_xml_text"
                android:background="@android:color/transparent" />
            <android.widget.ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/layout_xml_design_sort"
                android:contentDescription="@string/design_sort_by"
                android:padding="12dp"
                android:tint="@color/layout_xml_text"
                android:background="@android:color/transparent" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/organize_all_folders"
                    android:minHeight="48dp" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ideas"
                    android:minHeight="48dp" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estudios"
                    android:minHeight="48dp" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/organize_archived"
                    android:minHeight="48dp" />
                <android.widget.ImageButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/layout_xml_design_note"
                    android:contentDescription="@string/organize_manage_folders"
                    android:tint="@color/layout_xml_text"
                    android:padding="12dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </HorizontalScrollView>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/preview_08_notes_empty_framelayout_24">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp">
                <android.widget.ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/layout_xml_design_note"
                    android:padding="24dp"
                    android:tint="@color/layout_xml_text"
                    android:contentDescription="@null"
                    android:background="@drawable/layout_xml_tone" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mock_no_notes"
                    android:textSize="22sp"
                    android:textColor="@color/layout_xml_text"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mock_create_first_note"
                    android:textSize="14sp"
                    android:textColor="@color/layout_xml_text"
                    android:layout_marginTop="16dp"
                    android:gravity="center" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/design_create_first"
                    android:minHeight="48dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <android.widget.ImageButton
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/layout_xml_tone"
        android:backgroundTint="@color/layout_xml_primary"
        android:src="@drawable/preview_ic_add"
        android:tint="@color/layout_xml_on_primary"
        android:padding="18dp"
        android:id="@+id/preview_08_notes_empty_add"
        android:contentDescription="@string/mock_new_note" />
</FrameLayout>
