<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6E72B5"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Development"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">
                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/preview_circle_base"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#111111"
                    android:textSize="24sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="MyNotes"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Technical information about the application and its internal operation."
                        android:textColor="#E1E1E8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Application" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:text="Version                         1.0 (1)\nPackage                         com.example.mynotes\nBuild type                      Debug" android:textColor="#33333A" android:textSize="13sp" android:lineSpacingExtra="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="SDK and environment" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:text="Minimum Android              API 24\nTarget Android                 API 36\nCurrent device                 API 28" android:textColor="#33333A" android:textSize="13sp" android:lineSpacingExtra="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Build and distribution" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:text="Compile Android                 API 37&#10;Build system                    Gradle Kotlin DSL + KSP&#10;Java compatibility             Java 11&#10;Release optimization        Minify + shrink resources" android:textColor="#33333A" android:textSize="13sp" android:lineSpacingExtra="7dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Architecture" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif" android:text="Compose UI · ViewModel · Repository · Room · DataStore. Notes and attachments remain local, while settings are persisted independently." android:textColor="#55555E" android:textSize="12sp" android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Performance profiles" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/preview_small_unselected" android:padding="10dp" android:fontFamily="sans-serif" android:text="Maximum performance\n60 Hz · image/video 360 px · PDF 480 px" android:textColor="#222229" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/preview_small_selected" android:padding="10dp" android:fontFamily="sans-serif" android:text="Balanced   ·   CURRENT\n60 Hz · image/video 720 px · PDF 960 px" android:textColor="#222229" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/preview_small_unselected" android:padding="10dp" android:fontFamily="sans-serif" android:text="Maximum quality\nUp to 120 Hz · image 1280 px · video 1080 px · PDF 1440 px" android:textColor="#222229" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Main technologies" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif" android:text="Kotlin · Jetpack Compose · Material 3 · Room + KSP · DataStore · Coil 3 · Media3/ExoPlayer · Coroutines · AndroidX Lifecycle · Java 11" android:textColor="#55555E" android:textSize="12sp" android:lineSpacingExtra="4dp" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Authors and credits" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:text="Primary development              Snow
Development assistance      OpenAI ChatGPT" android:textColor="#33333A" android:textSize="13sp" android:lineSpacingExtra="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif" android:text="OpenAI ChatGPT is credited as technical assistance for review, documentation and development support." android:textColor="#55555E" android:textSize="12sp" android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Project repository" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:text="GitHub · lxxsnowxxl/Mynotes&#10;https://github.com/lxxsnowxxl/Mynotes" android:textColor="#33333A" android:textSize="13sp" android:lineSpacingExtra="6dp" />
                <TextView android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/preview_small_selected" android:gravity="center" android:fontFamily="sans-serif" android:text="↗  Open repository on GitHub" android:textColor="#222229" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Project source" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif" android:text="Open the internal source-code map to see the real paths and responsibilities of the main project files." android:textColor="#55555E" android:textSize="12sp" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/preview_small_selected" android:gravity="center" android:fontFamily="sans-serif" android:text="&lt;/&gt;  View code structure" android:textColor="#222229" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/preview_light_group"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Copyright and legal notices" android:textColor="#111111" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="sans-serif" android:text="© 2026 Snow · MyNotes&#10;License: proprietary — all rights reserved&#10;Third-party notices: included&#10;Bundled fonts: system sans-serif only." android:textColor="#33333A" android:textSize="13sp" android:lineSpacingExtra="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
