<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_screen_editor"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="18dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/preview_ic_arrow_back" android:tint="#111111" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/drawing_title" android:textColor="#111111" android:textSize="22sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/drawing_subtitle" android:textColor="#676770" android:textSize="11sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/preview_button_light">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/preview_ic_check" android:tint="#111111" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="✎     ~~~~~\n        ~~~~~~~~\n  ~~~~~"
            android:textColor="#3977D4"
            android:textSize="30sp" />
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/preview_button_light">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⛶" android:textColor="#111111" android:textSize="24sp" />
        </FrameLayout>
    </FrameLayout>

    <!-- El código V47/V48 incluye color de lienzo y modo de lienzo ampliado. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/drawing_tools" android:textColor="#111111" android:textSize="12sp" />

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="38dp" android:background="@drawable/preview_small_selected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/drawing_tool_pen" android:textColor="#111111" />
                <TextView android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="7dp" android:background="@drawable/preview_small_unselected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/drawing_tool_highlighter" android:textColor="#111111" />
                <TextView android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="7dp" android:background="@drawable/preview_small_unselected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/drawing_tool_marker" android:textColor="#111111" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif" android:text="@string/drawing_colors" android:textColor="#111111" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/preview_dot_gray" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_dot_cyan" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_dot_orange" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_dot_lime" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_dot_lav2" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_dot_neon_pink" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:fontFamily="sans-serif" android:text="@string/drawing_canvas_color" android:textColor="#111111" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/preview_circle_selected" android:backgroundTint="#FFFFFF" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_circle_base" android:backgroundTint="#FFF4C7" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_circle_base" android:backgroundTint="#FFE5EC" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_circle_base" android:backgroundTint="#DFF7EA" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_circle_base" android:backgroundTint="#34384A" />
            <View android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="7dp" android:background="@drawable/preview_circle_base" android:backgroundTint="#111111" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="68dp" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/drawing_thickness" android:textColor="#111111" android:textSize="12sp" />
            <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/preview_small_selected" android:gravity="center" android:fontFamily="sans-serif" android:text="@string/drawing_thin" android:textColor="#111111" />
            <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/preview_small_unselected" android:gravity="center" android:fontFamily="sans-serif" android:text="@string/drawing_medium" android:textColor="#111111" />
            <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/preview_small_unselected" android:gravity="center" android:fontFamily="sans-serif" android:text="@string/drawing_thick" android:textColor="#111111" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
