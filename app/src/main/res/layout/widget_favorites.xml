<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_favorites_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_screen_dark"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_favorites_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView android:id="@+id/widget_favorites_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_favorites" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_favorites_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E2FFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_favorites_add" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_action_primary_dark" android:contentDescription="@string/widget_new_note" android:padding="7dp" android:src="@drawable/widget_ic_add" />
    </LinearLayout>

    <TextView android:id="@+id/widget_favorites_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="10dp" android:text="@string/widget_empty_favorites" android:textColor="#BFFFFFFF" android:textSize="13sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/widget_favorites_cards" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_favorite_row_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/widget_note_card_dark" android:orientation="vertical" android:padding="6dp">
            <ImageView android:id="@+id/widget_favorite_thumb_1" android:layout_width="match_parent" android:layout_height="78dp" android:background="@drawable/widget_thumb_background_dark" android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/widget_thumb_placeholder" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_favorite_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                <ImageView android:id="@+id/widget_favorite_toggle_1" android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_action_circle_dark" android:contentDescription="@string/widget_toggle_favorite" android:padding="5dp" android:src="@drawable/widget_ic_star"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_favorite_preview_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:textColor="#F0FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/widget_favorite_meta_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="#DBFFFFFF" android:textSize="9sp"/>
            <TextView android:id="@+id/widget_favorite_accent_1" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:background="#FF7C6FF0"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_favorite_row_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/widget_note_card_dark" android:orientation="vertical" android:padding="6dp">
            <ImageView android:id="@+id/widget_favorite_thumb_2" android:layout_width="match_parent" android:layout_height="78dp" android:background="@drawable/widget_thumb_background_dark" android:padding="6dp" android:scaleType="fitCenter" android:src="@drawable/widget_thumb_placeholder" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_favorite_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                <ImageView android:id="@+id/widget_favorite_toggle_2" android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_action_circle_dark" android:contentDescription="@string/widget_toggle_favorite" android:padding="5dp" android:src="@drawable/widget_ic_star"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_favorite_preview_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:textColor="#F0FFFFFF" android:textSize="10sp"/>
            <TextView android:id="@+id/widget_favorite_meta_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="#DBFFFFFF" android:textSize="9sp"/>
            <TextView android:id="@+id/widget_favorite_accent_2" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:background="#FF7C6FF0"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
