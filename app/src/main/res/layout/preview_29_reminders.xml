<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_screen_editor"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/preview_ic_arrow_back" android:tint="#111111" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/reminders" android:textColor="#111111" android:textSize="27sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="2 activos" android:textColor="#66666D" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/preview_light_group"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/preview_circle_base">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="!" android:textColor="#111111" android:textSize="24sp" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/reminder_panel_title" android:textColor="#111111" android:textSize="16sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif" android:text="@string/reminder_panel_description" android:textColor="#66666D" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/preview_light_group"
            android:orientation="vertical"
            android:padding="15dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:text="Entregar reporte" android:textColor="#111111" android:textSize="17sp" />
                <FrameLayout android:layout_width="48dp" android:layout_height="28dp" android:background="@drawable/preview_switch_on" android:padding="3dp"><View android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="end" android:background="@drawable/preview_thumb_white" /></FrameLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif" android:text="23 sept. · 08:30 · Cada día" android:textColor="#5F6067" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/preview_chip_priority" android:fontFamily="sans-serif" android:text="Alta" android:textColor="#111111" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/preview_light_group"
            android:orientation="vertical"
            android:padding="15dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:text="Revisar notas" android:textColor="#111111" android:textSize="17sp" />
                <FrameLayout android:layout_width="48dp" android:layout_height="28dp" android:background="@drawable/preview_switch_on" android:padding="3dp"><View android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="end" android:background="@drawable/preview_thumb_white" /></FrameLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif" android:text="24 sept. · 20:15 · No repetir" android:textColor="#5F6067" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/preview_chip_light_selected" android:fontFamily="sans-serif" android:text="Normal" android:textColor="#111111" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/preview_button_dark"
        android:elevation="8dp">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/preview_ic_add" android:tint="#FFFFFF" />
    </FrameLayout>
</FrameLayout>
