<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layout_xml_screen"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    tools:ignore="HardcodedText,ContentDescription"
    android:id="@+id/preview_16_note_detail_media_framelayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/preview_16_note_detail_media_linearlayout_1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:id="@+id/preview_16_note_detail_media_linearlayout_2">
            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/preview_16_note_detail_media_back"
                android:src="@drawable/preview_ic_arrow_back"
                android:tint="@color/layout_xml_text"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mock_back"
                android:padding="12dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="24sp"
                android:textColor="@color/layout_xml_text"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:id="@+id/preview_16_note_detail_media_textview_4" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/preview_16_note_detail_media_framelayout_5">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:id="@+id/preview_16_note_detail_media_scrollview_6">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="32dp"
                    android:id="@+id/preview_16_note_detail_media_linearlayout_7">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proyecto de diseño"
                        android:textSize="29sp"
                        android:textColor="@color/layout_xml_text"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:id="@+id/preview_16_note_detail_media_textview_8" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="11dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:id="@+id/preview_16_note_detail_media_linearlayout_10">
                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:id="@+id/preview_16_note_detail_media_metadata_0"
                            android:text="@string/mock_priority_none"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginEnd="6dp" />
                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:id="@+id/preview_16_note_detail_media_metadata_1"
                            android:text="@string/mock_personal"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginEnd="6dp" />
                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:id="@+id/preview_16_note_detail_media_metadata_2"
                            android:text="26 oct. 2026"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_marginEnd="6dp" />
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="24dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Revisar materiales y medidas de la carcasa.&#10;Preparar la siguiente revisión."
                        android:textSize="16sp"
                        android:textColor="@color/layout_xml_secondary"
                        android:fontFamily="sans-serif"
                        android:textStyle="normal"
                        android:id="@+id/preview_16_note_detail_media_textview_15" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="26dp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/layout_xml_track"
                        android:id="@+id/preview_16_note_detail_media_view_17" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:id="@+id/preview_16_note_detail_media_linearlayout_18">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/attachments"
                            android:textSize="18sp"
                            android:textColor="@color/layout_xml_text"
                            android:fontFamily="sans-serif"
                            android:textStyle="bold"
                            android:layout_weight="1"
                            android:id="@+id/preview_16_note_detail_media_textview_19" />
                        <Button
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:id="@+id/preview_16_note_detail_media_add_attachment"
                            android:text="+"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/preview_media_photo"
                        android:layout_marginBottom="8dp"
                        android:id="@+id/preview_16_note_detail_media_framelayout_21">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/preview_ic_image"
                            android:contentDescription="@null"
                            android:layout_gravity="center"
                            android:tint="@color/layout_xml_text"
                            android:id="@+id/preview_16_note_detail_media_imageview_22" />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:background="@drawable/preview_media_photo"
                        android:layout_marginBottom="8dp"
                        android:id="@+id/preview_16_note_detail_media_framelayout_23">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/preview_ic_video"
                            android:contentDescription="@null"
                            android:layout_gravity="center"
                            android:tint="@color/layout_xml_text"
                            android:id="@+id/preview_16_note_detail_media_imageview_24" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3:00"
                            android:textSize="10sp"
                            android:textColor="@color/layout_xml_text"
                            android:fontFamily="sans-serif"
                            android:textStyle="normal"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="8dp"
                            android:id="@+id/preview_16_note_detail_media_textview_25" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:background="@drawable/layout_xml_panel"
                        android:padding="8dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:id="@+id/preview_16_note_detail_media_linearlayout_26">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/preview_ic_music"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp"
                            android:tint="@color/layout_xml_text"
                            android:id="@+id/preview_16_note_detail_media_imageview_27" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Nota de voz.m4a"
                            android:textSize="12sp"
                            android:textColor="@color/layout_xml_text"
                            android:fontFamily="sans-serif"
                            android:textStyle="normal"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:id="@+id/preview_16_note_detail_media_textview_28" />
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:id="@+id/preview_16_note_detail_media_linearlayout_30">
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:id="@+id/preview_16_note_detail_media_action_share"
                            android:text="@string/mock_share"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:id="@+id/preview_16_note_detail_media_action_pin"
                            android:text="@string/mock_pin"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:id="@+id/preview_16_note_detail_media_action_move"
                            android:text="@string/mock_move"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:id="@+id/preview_16_note_detail_media_action_delete"
                            android:text="@string/mock_delete"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <View
                android:layout_width="4dp"
                android:layout_height="54dp"
                android:id="@+id/preview_16_note_detail_media_scroll_capsule"
                android:layout_gravity="end|top"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/layout_xml_scroll_capsule"
                android:importantForAccessibility="no"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
