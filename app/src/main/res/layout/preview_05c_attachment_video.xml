<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_xml_app_background"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    android:id="@+id/preview_05c_attachment_video_linearlayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:id="@+id/preview_05c_attachment_video_linearlayout_1">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/preview_ic_arrow_back"
            android:tint="@color/layout_xml_text"
            android:contentDescription="@null"
            android:layout_margin="8dp"
            android:id="@+id/preview_05c_attachment_video_imageview_2" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="video.mp4"
            android:textColor="@color/layout_xml_text"
            android:textSize="18sp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="true"
            android:id="@+id/preview_05c_attachment_video_textview_3" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="↗"
            android:textColor="@color/layout_xml_text"
            android:textSize="24sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_05c_attachment_video_textview_4" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/preview_video_surface"
        android:id="@+id/preview_05c_attachment_video_framelayout_5">
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/preview_ic_video"
            android:tint="@color/layout_xml_text"
            android:contentDescription="@null"
            android:layout_gravity="center"
            android:id="@+id/preview_05c_attachment_video_imageview_6" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="@drawable/preview_control_bar"
        android:orientation="vertical"
        android:padding="12dp"
        android:id="@+id/preview_05c_attachment_video_linearlayout_7">
        <SeekBar
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progress="32"
            android:progressDrawable="@drawable/layout_xml_slider_progress"
            android:thumb="@drawable/layout_xml_slider_thumb"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:id="@+id/preview_05c_attachment_video_seekbar_8" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/preview_05c_attachment_video_linearlayout_9">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="▶"
                android:textColor="@color/layout_xml_text"
                android:textSize="25sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_05c_attachment_video_textview_10" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="00:16 / 00:51"
                android:textColor="@color/layout_xml_text"
                android:textSize="13sp"
                android:layout_marginStart="12dp"
                android:includeFontPadding="true"
                android:id="@+id/preview_05c_attachment_video_textview_11" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
