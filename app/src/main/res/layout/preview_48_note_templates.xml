<?xml version="1.0" encoding="utf-8"?>
<!-- v312: editable design reference; production screen is implemented in Compose. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_xml_app_background"
    android:theme="@style/LayoutXmlPreviewTheme"
    android:padding="16dp">
    <include
        layout="@layout/preview_02_note_editor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_gravity="center"
        android:background="@drawable/layout_xml_tone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_templates"
            android:textSize="22sp"
            android:textColor="@color/layout_xml_text"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_template_meeting"
            android:textSize="18sp"
            android:textColor="@color/layout_xml_text"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_template_meeting_body"
            android:textSize="12sp"
            android:textColor="@color/layout_xml_text"
            android:maxLines="5" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_use_template"
            android:minHeight="48dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_template_journal"
            android:textSize="18sp"
            android:textColor="@color/layout_xml_text"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_template_journal_body"
            android:textSize="12sp"
            android:textColor="@color/layout_xml_text"
            android:maxLines="5" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_use_template"
            android:minHeight="48dp" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_blank_note"
            android:minHeight="48dp" />
    </LinearLayout>
</FrameLayout>
