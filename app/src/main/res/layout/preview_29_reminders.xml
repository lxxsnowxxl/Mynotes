<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layout_xml_screen"
    tools:ignore="HardcodedText,ContentDescription"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    android:id="@+id/preview_29_reminders_framelayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp"
        android:id="@+id/preview_29_reminders_linearlayout_1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/preview_29_reminders_linearlayout_2">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/preview_ic_arrow_back"
                android:tint="@color/layout_xml_text"
                android:id="@+id/preview_29_reminders_imageview_3" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:id="@+id/preview_29_reminders_linearlayout_4">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/reminders"
                    android:textColor="@color/layout_xml_text"
                    android:textSize="27sp"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_29_reminders_textview_5" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="2 activos"
                    android:textColor="@color/layout_xml_text"
                    android:textSize="13sp"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_29_reminders_textview_6" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/preview_light_group"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:id="@+id/preview_29_reminders_linearlayout_7">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/preview_circle_base"
                android:id="@+id/preview_29_reminders_framelayout_8">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="@color/layout_xml_text"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_29_reminders_textview_9" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:id="@+id/preview_29_reminders_linearlayout_10">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/reminder_panel_title"
                    android:textColor="@color/layout_xml_text"
                    android:textSize="16sp"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_29_reminders_textview_11" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/reminder_panel_description"
                    android:textColor="@color/layout_xml_text"
                    android:textSize="12sp"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_29_reminders_textview_12" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/preview_light_group"
            android:orientation="vertical"
            android:padding="15dp"
            android:id="@+id/preview_29_reminders_linearlayout_13">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/preview_29_reminders_linearlayout_14">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Entregar reporte"
                    android:textColor="@color/layout_xml_text"
                    android:textSize="17sp"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_29_reminders_textview_15" />
                <Switch
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:checked="true"
                    android:switchMinWidth="52dp"
                    android:thumb="@drawable/layout_xml_switch_thumb"
                    android:track="@drawable/layout_xml_switch_track"
                    android:splitTrack="false"
                    android:id="@+id/preview_29_reminders_switch_16" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="23 sept. · 08:30 · Cada día"
                android:textColor="@color/layout_xml_text"
                android:textSize="12sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_29_reminders_textview_17" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/preview_chip_priority"
                android:fontFamily="sans-serif"
                android:text="@string/reminder_priority_high"
                android:textColor="@color/layout_xml_text"
                android:textSize="11sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_29_reminders_textview_18" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/preview_light_group"
            android:orientation="vertical"
            android:padding="15dp"
            android:id="@+id/preview_29_reminders_linearlayout_19">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/preview_29_reminders_linearlayout_20">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Revisar notas"
                    android:textColor="@color/layout_xml_text"
                    android:textSize="17sp"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_29_reminders_textview_21" />
                <Switch
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:checked="true"
                    android:switchMinWidth="52dp"
                    android:thumb="@drawable/layout_xml_switch_thumb"
                    android:track="@drawable/layout_xml_switch_track"
                    android:splitTrack="false"
                    android:id="@+id/preview_29_reminders_switch_22" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="24 sept. · 20:15 · No repetir"
                android:textColor="@color/layout_xml_text"
                android:textSize="12sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_29_reminders_textview_23" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/preview_chip_light_selected"
                android:fontFamily="sans-serif"
                android:text="@string/reminder_priority_normal"
                android:textColor="@color/layout_xml_text"
                android:textSize="11sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_29_reminders_textview_24" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/preview_button_dark"
        android:elevation="8dp"
        android:id="@+id/preview_29_reminders_framelayout_25">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/preview_ic_add"
            android:tint="@color/layout_xml_text"
            android:id="@+id/preview_29_reminders_imageview_26" />
    </FrameLayout>
</FrameLayout>
