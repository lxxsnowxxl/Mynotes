<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_screen_editor"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout android:layout_width="match_parent" android:layout_height="74dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/preview_ic_arrow_back" android:tint="#111111" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/pdf_studio" android:textColor="#111111" android:textSize="27sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif" android:text="@string/pdf_studio_subtitle" android:textColor="#5E5F66" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="128dp" android:layout_height="52dp" android:background="@drawable/preview_button_dark" android:gravity="center" android:fontFamily="sans-serif" android:text="@string/pdf_export" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="290dp" android:layout_height="50dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:background="@drawable/preview_light_group" android:elevation="7dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:layout_width="40dp" android:layout_height="36dp" android:background="@drawable/preview_button_light" android:gravity="center" android:text="↶" android:textColor="#777777" android:textSize="21sp" />
        <TextView android:layout_width="40dp" android:layout_height="36dp" android:layout_marginStart="5dp" android:background="@drawable/preview_button_light" android:gravity="center" android:text="↷" android:textColor="#777777" android:textSize="21sp" />
        <TextView android:layout_width="30dp" android:layout_height="36dp" android:gravity="center" android:text="‹" android:textColor="#999999" android:textSize="22sp" />
        <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/preview_chip_light_selected" android:gravity="center" android:fontFamily="sans-serif" android:text="#  Página 1 de 1" android:textColor="#111111" android:textSize="12sp" />
        <TextView android:layout_width="30dp" android:layout_height="36dp" android:gravity="center" android:text="›" android:textColor="#999999" android:textSize="22sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="@drawable/preview_pdf_page">

        <!-- V94: Abrir PDF está centrado dentro del canvas y se oculta al cargar un PDF. -->
        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/preview_button_light"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/preview_ic_file" android:tint="#111111" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="sans-serif" android:text="@string/pdf_open_pdf" android:textColor="#111111" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/preview_light_group"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="15dp"
            android:paddingEnd="52dp"
            android:paddingBottom="15dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="@string/pdf_test_mode_title" android:textColor="#111111" android:textSize="18sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" android:text="@string/pdf_test_mode_description" android:textColor="#64656B" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center|end" android:layout_marginEnd="34dp" android:layout_marginBottom="154dp" android:background="@drawable/preview_surface_dark" android:gravity="center" android:text="×" android:textColor="#FFFFFF" android:textSize="28sp" />
    </FrameLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="8dp" android:background="@drawable/preview_light_group" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/preview_small_selected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/pdf_select" android:textColor="#111111" />
            <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/preview_small_unselected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/pdf_draw" android:textColor="#111111" />
            <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/preview_small_unselected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/pdf_highlighter" android:textColor="#111111" />
            <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/preview_small_unselected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/pdf_text" android:textColor="#111111" />
            <TextView android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/preview_small_unselected" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:fontFamily="sans-serif" android:text="@string/pdf_add_image" android:textColor="#111111" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
