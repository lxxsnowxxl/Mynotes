<?xml version="1.0" encoding="utf-8"?>
<!-- Recuadro compartido por las vistas XML de Configuración. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/layout_xml_panel">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/design_styles"
            android:textSize="18sp"
            android:textColor="@color/layout_xml_text"
            android:textStyle="bold" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/design_preview"
            android:minHeight="48dp" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/design_styles_description"
        android:textSize="12sp"
        android:textColor="@color/layout_xml_secondary"
        android:layout_marginTop="8dp" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:background="#FFF3F2EF">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#FFD9D0C5" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/design_preset_minimal"
                    android:textSize="14sp"
                    android:textColor="#FF202020"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:background="#FFFFF7E5">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#FFD9D0C5" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/design_preset_notebook"
                    android:textSize="14sp"
                    android:textColor="#FF202020"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:background="#FF101010">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#FF303030" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/design_preset_oled"
                    android:textSize="14sp"
                    android:textColor="#FFFFFFFF"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="148dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:background="#FFE6E8F2">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#FFFAFAFE" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/design_preset_default"
                    android:textSize="14sp"
                    android:textColor="#FF414963"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/design_density"
        android:textSize="16sp"
        android:textColor="@color/layout_xml_text"
        android:layout_marginTop="16dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/design_compact"
            android:minHeight="48dp" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/design_comfortable"
            android:minHeight="48dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/design_focus"
                android:textSize="14sp"
                android:textColor="@color/layout_xml_text" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/design_focus_description"
                android:textSize="12sp"
                android:textColor="@color/layout_xml_secondary" />
        </LinearLayout>
        <Switch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/design_focus"
            android:checked="true"
            android:minHeight="48dp" />
    </LinearLayout>
</LinearLayout>
