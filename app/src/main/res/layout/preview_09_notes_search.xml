<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/preview_screen_home" tools:ignore="HardcodedText,ContentDescription">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:gravity="bottom|center_vertical" android:orientation="horizontal" android:paddingBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_bold" android:text="My notes" android:textColor="#FFFFFF" android:textSize="30sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_bold" android:text="Search results" android:textColor="#E8E8F0" android:textSize="13sp" />
            </LinearLayout>
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/preview_ic_settings" android:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/preview_search_dark" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="15dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/preview_ic_search" android:tint="#9092A0" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:fontFamily="@font/google_sans_bold" android:text="libertad" android:textColor="#FFFFFF" android:textSize="16sp" />
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="×" android:textColor="#FFFFFF" android:textSize="24sp" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="62dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/preview_chip_light_selected" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:fontFamily="@font/google_sans_bold" android:text="All" android:textColor="#111111" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/preview_chip_dark" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:fontFamily="@font/google_sans_bold" android:text="Favorites" android:textColor="#FFFFFF" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/preview_chip_dark" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:fontFamily="@font/google_sans_bold" android:text="Work" android:textColor="#FFFFFF" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/preview_chip_dark" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:fontFamily="@font/google_sans_bold" android:text="Personal" android:textColor="#FFFFFF" android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/google_sans_medium" android:text="2 notes match “libertad”" android:textColor="#E5E6EE" android:textSize="12sp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="90dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/preview_note_light" android:orientation="vertical" android:paddingBottom="12dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp" android:background="@drawable/preview_media_photo"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="IMAGE" android:textColor="#FFFFFF" android:textStyle="bold" /></FrameLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_bold" android:text="El conflicto de lo irreal" android:textColor="#111111" android:textSize="18sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="5" android:fontFamily="@font/google_sans_bold" android:text="Hay algo curioso con la libertad. Todos decimos que la queremos, que la defendemos y que es uno de los derechos..." android:textColor="#6B6D73" android:textSize="14sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="wrap_content" android:layout_height="28dp" android:background="@drawable/preview_tag_personal" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Personal" android:textColor="#B44C4C" android:textSize="11sp" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Sep 5, 2026" android:textColor="#64666E" android:textSize="11sp" /></LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <Space android:layout_width="10dp" android:layout_height="1dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/preview_note_dark" android:orientation="vertical" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/preview_ic_star" android:tint="#FFFFFF" /><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" /><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/preview_ic_more" android:tint="#FFFFFF" /></LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/google_sans_bold" android:text="Untitled" android:textColor="#FFFFFF" android:textSize="18sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="6" android:fontFamily="@font/google_sans_bold" android:text="6.69 复制打开抖音，看看《如梦到过这里吗》一被许诺的未来... https://v.douyin.com/..." android:textColor="#9899A4" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="10dp" android:background="@drawable/preview_link_card" android:orientation="vertical"><FrameLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/preview_media_video"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="D" android:textColor="#FFFFFF" android:textSize="18sp" /></FrameLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingTop="7dp" android:fontFamily="@font/google_sans_bold" android:text="Douyin" android:textColor="#A6A7B1" android:textSize="10sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp" android:fontFamily="@font/google_sans_bold" android:text="在抖音记录美好生活..." android:textColor="#FFFFFF" android:textSize="12sp" /></LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginTop="10dp" android:background="@drawable/preview_tag_personal" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Personal" android:textColor="#B44C4C" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="bottom|end" android:layout_margin="18dp" android:background="@drawable/preview_accent_button"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/preview_ic_add" android:tint="#FFFFFF" /></FrameLayout>
</FrameLayout>