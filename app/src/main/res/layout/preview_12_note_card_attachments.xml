        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif" android:text="2 attachments" android:textColor="#111111" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="7dp" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/preview_media_photo"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="IMAGE" android:textColor="#FFFFFF" /></FrameLayout><Space android:layout_width="4dp" android:layout_height="1dp" /><FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/preview_media_video"><ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:src="@drawable/preview_ic_video" android:tint="#FFFFFF" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="7dp" android:background="@drawable/preview_chip_dark" android:padding="5dp" android:text="1:42" android:textColor="#FFFFFF" android:textSize="10sp" /></FrameLayout></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif" android:text="3–4 attachments" android:textColor="#111111" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="7dp" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:background="@drawable/preview_media_photo"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="PHOTO" android:textColor="#FFFFFF" /></FrameLayout><Space android:layout_width="4dp" android:layout_height="1dp" /><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/preview_media_audio"><ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@drawable/preview_ic_music" android:tint="#FFFFFF" /></FrameLayout><Space android:layout_width="1dp" android:layout_height="4dp" /><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/preview_media_document"><ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@drawable/preview_ic_file" android:tint="#FFFFFF" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp" android:text="PDF" android:textColor="#FFFFFF" android:textSize="10sp" /></FrameLayout></LinearLayout></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif" android:text="Fallback file tiles" android:textColor="#111111" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="7dp" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/preview_attachment" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/preview_ic_file" android:tint="#3F4350" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="DOCX" android:textColor="#3F4350" android:textSize="10sp" /></LinearLayout><Space android:layout_width="6dp" android:layout_height="1dp" /><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/preview_attachment_dark" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/preview_ic_mic" android:tint="#FFFFFF" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Voice note" android:textColor="#FFFFFF" android:textSize="10sp" /></LinearLayout></LinearLayout>
    </LinearLayout>
