<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layout_xml_screen"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    android:id="@+id/preview_05b_attachment_image_linearlayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:id="@+id/preview_05b_attachment_image_linearlayout_1">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/preview_ic_arrow_back"
            android:tint="@color/layout_xml_text"
            android:contentDescription="@null"
            android:layout_margin="8dp"
            android:id="@+id/preview_05b_attachment_image_imageview_2" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="photo.jpg"
            android:textColor="@color/layout_xml_text"
            android:textSize="18sp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="true"
            android:id="@+id/preview_05b_attachment_image_textview_3" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="↗"
            android:textColor="@color/layout_xml_text"
            android:textSize="24sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_05b_attachment_image_textview_4" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/preview_media_photo"
        android:id="@+id/preview_05b_attachment_image_framelayout_5">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif"
            android:text="IMAGE PREVIEW"
            android:textColor="@color/layout_xml_text"
            android:textSize="22sp"
            android:gravity="center"
            android:includeFontPadding="true"
            android:id="@+id/preview_05b_attachment_image_textview_6" />
    </FrameLayout>
</LinearLayout>
