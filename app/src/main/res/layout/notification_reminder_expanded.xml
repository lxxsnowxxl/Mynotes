<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_notification_root"
    android:layout_width="match_parent"
    android:layout_height="148dp"
    android:padding="4dp">

    <ImageView
        android:id="@+id/reminder_notification_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/reminder_notification_panel" />

    <ImageView
        android:id="@+id/reminder_notification_accent"
        android:layout_width="4dp"
        android:layout_height="108dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:scaleType="fitXY"
        android:src="@drawable/reminder_notification_accent" />

    <ImageView
        android:id="@+id/reminder_notification_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="27dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/ic_reminder_notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reminder_notification_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans_medium"
            android:maxLines="1"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/reminder_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans_bold"
            android:maxLines="2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/reminder_notification_description"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans_regular"
            android:maxLines="3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/reminder_notification_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans_medium"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
