<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_recent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_screen_dark"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_recent_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView android:id="@+id/widget_recent_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_recent_notes" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_recent_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E2FFFFFF" android:textSize="9sp" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_recent_search" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/widget_action_circle_dark" android:contentDescription="@string/widget_search" android:padding="6dp" android:src="@drawable/widget_ic_search" />
        <ImageView android:id="@+id/widget_recent_add" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:background="@drawable/widget_action_primary_dark" android:contentDescription="@string/widget_new_note" android:padding="6dp" android:src="@drawable/widget_ic_add" />
    </LinearLayout>

    <TextView android:id="@+id/widget_recent_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="8dp" android:text="@string/widget_empty_notes" android:textColor="#BFFFFFFF" android:textSize="11sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/widget_recent_cards" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="2dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/widget_note_row_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_note_card_dark" android:orientation="vertical" android:padding="5dp">
            <ImageView android:id="@+id/widget_note_thumb_1" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/widget_thumb_background_dark" android:padding="4dp" android:scaleType="centerCrop" android:src="@drawable/widget_thumb_placeholder" />
            <TextView android:id="@+id/widget_note_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/widget_note_preview_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="8" android:textColor="#F0FFFFFF" android:textSize="9sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_note_meta_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#DBFFFFFF" android:textSize="8sp"/>
                <TextView android:id="@+id/widget_note_badge_1" android:layout_width="wrap_content" android:layout_height="20dp" android:background="@drawable/widget_action_circle_dark" android:gravity="center" android:minWidth="20dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:textColor="#CEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/widget_note_accent_1" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:background="#FF7C6FF0" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_note_row_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_note_card_dark" android:orientation="vertical" android:padding="5dp">
            <ImageView android:id="@+id/widget_note_thumb_2" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/widget_thumb_background_dark" android:padding="4dp" android:scaleType="centerCrop" android:src="@drawable/widget_thumb_placeholder" />
            <TextView android:id="@+id/widget_note_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/widget_note_preview_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="8" android:textColor="#F0FFFFFF" android:textSize="9sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_note_meta_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#DBFFFFFF" android:textSize="8sp"/>
                <TextView android:id="@+id/widget_note_badge_2" android:layout_width="wrap_content" android:layout_height="20dp" android:background="@drawable/widget_action_circle_dark" android:gravity="center" android:minWidth="20dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:textColor="#CEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/widget_note_accent_2" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp" android:background="#FF7C6FF0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
