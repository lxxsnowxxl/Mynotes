        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="States represented by NoteCardAttachmentsPreview and NoteCardAttachmentTile." android:textColor="#606169" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif" android:text="1 attachment" android:textColor="#111111" android:textSize="14sp" />
