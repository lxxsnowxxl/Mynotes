<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_xml_app_background"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    tools:ignore="HardcodedText,ContentDescription"
    android:id="@+id/preview_34_configuration_mode_dialog_framelayout_0">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8F000000"
        android:id="@+id/preview_34_configuration_mode_dialog_view_1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/layout_xml_dialog"
        android:layout_gravity="center"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:padding="22dp"
        android:id="@+id/preview_34_configuration_mode_dialog_linearlayout_2">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configuration_mode_welcome_title"
            android:textSize="22sp"
            android:textColor="@color/layout_xml_text"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:id="@+id/preview_34_configuration_mode_dialog_textview_3" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configuration_mode_welcome_description"
            android:textSize="13sp"
            android:textColor="@color/layout_xml_secondary"
            android:fontFamily="sans-serif"
            android:textStyle="normal"
            android:layout_marginTop="6dp"
            android:id="@+id/preview_34_configuration_mode_dialog_textview_4" />
        <Space
            android:layout_width="1dp"
            android:layout_height="18dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/layout_xml_button_outline"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/preview_34_configuration_mode_dialog_choose_basic">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/configuration_mode_basic"
                android:textSize="14sp"
                android:textColor="@color/layout_xml_text"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:id="@+id/preview_34_configuration_mode_dialog_textview_7" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/configuration_mode_basic_description"
                android:textSize="11sp"
                android:textColor="@color/layout_xml_text"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:layout_marginTop="4dp"
                android:id="@+id/preview_34_configuration_mode_dialog_textview_8" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/layout_xml_button_outline"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/preview_34_configuration_mode_dialog_choose_advanced">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/configuration_mode_advanced"
                android:textSize="14sp"
                android:textColor="@color/layout_xml_text"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:id="@+id/preview_34_configuration_mode_dialog_textview_10" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/configuration_mode_advanced_description"
                android:textSize="11sp"
                android:textColor="@color/layout_xml_text"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:layout_marginTop="4dp"
                android:id="@+id/preview_34_configuration_mode_dialog_textview_11" />
        </LinearLayout>
        <Space
            android:layout_width="1dp"
            android:layout_height="6dp" />
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/preview_34_configuration_mode_dialog_confirm"
            android:text="@string/configuration_mode_confirm"
            android:textAllCaps="false"
            android:textColor="@color/layout_xml_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:background="@drawable/layout_xml_button_outline"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:enabled="false" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configuration_mode_change_later"
            android:textSize="11sp"
            android:textColor="@color/layout_xml_secondary"
            android:fontFamily="sans-serif"
            android:textStyle="normal"
            android:layout_marginTop="14dp"
            android:id="@+id/preview_34_configuration_mode_dialog_textview_14" />
    </LinearLayout>
</FrameLayout>
