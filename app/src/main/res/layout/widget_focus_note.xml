<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_screen_dark"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout android:id="@+id/widget_focus_header" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_focus_title_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_focus_note" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_focus_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_focus_note_hint" android:textColor="#E2FFFFFF" android:textSize="9sp" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_focus_add" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/widget_action_primary_dark" android:contentDescription="@string/widget_new_note" android:padding="6dp" android:src="@drawable/widget_ic_add" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_focus_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1" android:background="@drawable/widget_detail_card_dark" android:orientation="horizontal" android:padding="6dp">
        <ImageView android:id="@+id/widget_focus_thumb" android:layout_width="74dp" android:layout_height="match_parent" android:background="@drawable/widget_thumb_background_dark" android:padding="6dp" android:scaleType="centerCrop" android:src="@drawable/widget_thumb_placeholder" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_focus_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <ImageView android:id="@+id/widget_focus_favorite" android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/widget_action_circle_dark" android:contentDescription="@string/widget_toggle_favorite" android:padding="4dp" android:src="@drawable/widget_ic_star" />
                <ImageView android:id="@+id/widget_focus_pin" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginStart="4dp" android:background="@drawable/widget_action_circle_dark" android:contentDescription="@string/widget_toggle_pin" android:padding="4dp" android:src="@drawable/widget_ic_pin" />
            </LinearLayout>
            <TextView android:id="@+id/widget_focus_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="#DBFFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/widget_focus_preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="3" android:textColor="#F0FFFFFF" android:textSize="10sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_focus_open" android:layout_width="wrap_content" android:layout_height="24dp" android:background="@drawable/widget_chip_dark" android:gravity="center" android:minWidth="74dp" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="@string/widget_open_note" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_focus_badge" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginStart="6dp" android:background="@drawable/widget_action_circle_dark" android:gravity="center" android:minWidth="20dp" android:paddingLeft="5dp" android:paddingRight="5dp" android:textColor="#CEFFFFFF" android:textSize="8sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_focus_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:padding="8dp" android:text="@string/widget_empty_notes" android:textColor="#BFFFFFFF" android:textSize="10sp" android:visibility="gone" />
</LinearLayout>
