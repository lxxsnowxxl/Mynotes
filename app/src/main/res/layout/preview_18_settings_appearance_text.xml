                            android:gravity="center_vertical"
                            android:id="@+id/preview_18_settings_appearance_text_linearlayout_67">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/haptic_effects_style"
                                android:textSize="14sp"
                                android:textColor="@color/layout_xml_text"
                                android:fontFamily="sans-serif"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:id="@+id/preview_18_settings_appearance_text_textview_68" />
                            <Spinner
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:id="@+id/preview_18_settings_appearance_text_haptic_effects_theme"
                                android:entries="@array/layout_xml_haptic_effects_theme_options"
                                android:spinnerMode="dropdown"
                                android:contentDescription="@string/haptic_effects_style" />
                        </LinearLayout>
                        <Button
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/preview_18_settings_appearance_text_haptic_effects_preview"
                            android:text="@string/haptic_effects_preview"
                            android:textAllCaps="false"
                            android:textColor="@color/layout_xml_text"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:minHeight="44dp"
                            android:minWidth="0dp"
                            android:background="@drawable/layout_xml_button_outline"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />
                        <Space
                            android:layout_width="1dp"
                            android:layout_height="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:minHeight="24dp"
                            android:gravity="center_vertical"
                            android:id="@+id/preview_18_settings_appearance_text_linearlayout_72">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/haptic_effects_intensity"
                                android:textSize="14sp"
                                android:textColor="@color/layout_xml_text"
                                android:fontFamily="sans-serif"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:id="@+id/preview_18_settings_appearance_text_textview_73" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="55%"
                                android:textSize="12sp"
                                android:textColor="@color/layout_xml_text"
                                android:fontFamily="sans-serif"
                                android:textStyle="normal"
                                android:id="@+id/preview_18_settings_appearance_text_haptic_effects_volume_value"
                                android:layout_marginStart="10dp" />
                        </LinearLayout>
                        <SeekBar
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:id="@+id/preview_18_settings_appearance_text_haptic_effects_volume"
                            android:max="1000"
                            android:progress="550"
                            android:progressDrawable="@drawable/layout_xml_slider_progress"
                            android:thumb="@drawable/layout_xml_slider_thumb"
                            android:thumbOffset="9dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:splitTrack="false"
                            android:contentDescription="@string/haptic_effects_intensity" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <View
                android:layout_width="4dp"
                android:layout_height="54dp"
                android:id="@+id/preview_18_settings_appearance_text_scroll_capsule"
                android:layout_gravity="end|top"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/layout_xml_scroll_capsule"
                android:importantForAccessibility="no"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
