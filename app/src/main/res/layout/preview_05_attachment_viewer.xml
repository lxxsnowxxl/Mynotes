<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layout_xml_screen"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    android:id="@+id/preview_05_attachment_viewer_linearlayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:id="@+id/preview_05_attachment_viewer_linearlayout_1">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/preview_ic_arrow_back"
            android:tint="@color/layout_xml_text"
            android:contentDescription="@null"
            android:layout_margin="8dp"
            android:id="@+id/preview_05_attachment_viewer_imageview_2" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="documento.pdf"
            android:textColor="@color/layout_xml_text"
            android:textSize="18sp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="true"
            android:id="@+id/preview_05_attachment_viewer_textview_3" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="↗"
            android:textColor="@color/layout_xml_text"
            android:textSize="24sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_05_attachment_viewer_textview_4" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:id="@+id/preview_05_attachment_viewer_framelayout_5">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/preview_pdf_page"
            android:orientation="vertical"
            android:padding="28dp"
            android:id="@+id/preview_05_attachment_viewer_linearlayout_6">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="PROJECT DOCUMENT"
                android:textColor="@color/layout_xml_text"
                android:textSize="23sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_05_attachment_viewer_textview_7" />
            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Page 1 of 4"
                android:textColor="@color/layout_xml_text"
                android:textSize="12sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_05_attachment_viewer_textview_9" />
            <Space
                android:layout_width="1dp"
                android:layout_height="20dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This preview represents the PDF page rendering area.  ──────────────────────── ──────────────────── ────────────────────────  ────────────────────── ──────────────────────── ──────────────────"
                android:textColor="@color/layout_xml_text"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="6dp"
                android:includeFontPadding="true"
                android:id="@+id/preview_05_attachment_viewer_textview_11" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
