<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layout_xml_screen"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    tools:ignore="HardcodedText,ContentDescription"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    android:id="@+id/preview_33_pdf_editor_loaded_linearlayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/preview_33_pdf_editor_loaded_linearlayout_1">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/preview_ic_arrow_back"
            android:tint="@color/layout_xml_text"
            android:id="@+id/preview_33_pdf_editor_loaded_imageview_2" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:id="@+id/preview_33_pdf_editor_loaded_linearlayout_3">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_studio"
                android:textColor="@color/layout_xml_text"
                android:textSize="27sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_4" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_studio_subtitle"
                android:textColor="@color/layout_xml_text"
                android:textSize="13sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_5" />
        </LinearLayout>
        <TextView
            android:layout_width="128dp"
            android:layout_height="52dp"
            android:background="@drawable/preview_button_dark"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="@string/pdf_export"
            android:textColor="@color/layout_xml_text"
            android:textSize="14sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_6" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="290dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group"
        android:elevation="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:id="@+id/preview_33_pdf_editor_loaded_linearlayout_7">
        <TextView
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/preview_button_light"
            android:gravity="center"
            android:text="↶"
            android:textColor="@color/layout_xml_text"
            android:textSize="21sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_8" />
        <TextView
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/preview_button_light"
            android:gravity="center"
            android:text="↷"
            android:textColor="@color/layout_xml_text"
            android:textSize="21sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_9" />
        <TextView
            android:layout_width="30dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/layout_xml_text"
            android:textSize="22sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_10" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/preview_chip_light_selected"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="#  Página 1 de 2"
            android:textColor="@color/layout_xml_text"
            android:textSize="12sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_11" />
        <TextView
            android:layout_width="30dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/layout_xml_text"
            android:textSize="22sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_12" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="@drawable/preview_pdf_page"
        android:id="@+id/preview_33_pdf_editor_loaded_framelayout_13">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|center_horizontal"
            android:paddingTop="20dp"
            android:fontFamily="sans-serif"
            android:text="DOCUMENTO BASE\n\nNombre: __________________________\nMateria: _________________________\n\nCalificación     Créditos     Grupo\n──────────      ────────     ─────\n──────────      ────────     ─────\n──────────      ────────     ─────\n\n\n\n\n\n\nPromedio: __________"
            android:textColor="@color/layout_xml_text"
            android:textSize="10sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_14" />
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/preview_media_photo"
            android:elevation="3dp"
            android:id="@+id/preview_33_pdf_editor_loaded_framelayout_15">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="sans-serif"
                android:text="IMAGEN\nEDITABLE"
                android:textColor="@color/layout_xml_text"
                android:textSize="18sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_16" />
        </FrameLayout>
        <TextView
            android:layout_width="230dp"
            android:layout_height="60dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="110dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="trazo / recuadro editable"
            android:textColor="@color/layout_xml_text"
            android:textSize="15sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_17" />
        <TextView
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="Texto editable"
            android:textColor="@color/layout_xml_text"
            android:textSize="15sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_33_pdf_editor_loaded_textview_18" />
    </FrameLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group"
        android:scrollbars="none"
        android:id="@+id/preview_33_pdf_editor_loaded_horizontalscrollview_19">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:id="@+id/preview_33_pdf_editor_loaded_linearlayout_20">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/preview_small_selected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_select"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_21" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_draw"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_22" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_highlighter"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_23" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_text"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_24" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_add_image"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_25" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/pdf_pages"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_33_pdf_editor_loaded_textview_26" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
