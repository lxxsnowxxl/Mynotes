<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DFD8CF" />
            <corners android:topLeftRadius="6dp" android:bottomLeftRadius="6dp"
                android:topRightRadius="24dp" android:bottomRightRadius="24dp" />
            <stroke android:width="0.75dp" android:color="#8C7B7774" />
        </shape>
    </item>
    <item android:width="14dp" android:height="3dp"
        android:gravity="top|center_horizontal" android:top="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#66625E" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
