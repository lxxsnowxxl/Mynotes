<?xml version="1.0" encoding="utf-8"?>
<!-- v312: editable design reference; production screen is implemented in Compose. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_xml_app_background"
    android:theme="@style/LayoutXmlPreviewTheme"
    android:padding="16dp">
    <include
        layout="@layout/preview_15_note_editor_edit_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_gravity="center"
        android:background="@drawable/layout_xml_tone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_cover"
            android:textSize="22sp"
            android:textColor="@color/layout_xml_text"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />
        <android.widget.ImageView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:src="@drawable/preview_media_photo"
            android:scaleType="centerCrop"
            android:contentDescription="@string/organize_cover" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_choose_cover"
            android:minHeight="48dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_crop_horizontal"
            android:textSize="14sp"
            android:textColor="@color/layout_xml_text" />
        <SeekBar
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/layout_xml_slider_progress"
            android:thumb="@drawable/layout_xml_slider_thumb"
            android:thumbOffset="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:splitTrack="false"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_crop_vertical"
            android:textSize="14sp"
            android:textColor="@color/layout_xml_text" />
        <SeekBar
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/layout_xml_slider_progress"
            android:thumb="@drawable/layout_xml_slider_thumb"
            android:thumbOffset="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:splitTrack="false"/>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_remove_cover"
            android:minHeight="48dp" />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_done"
            android:minHeight="48dp" />
    </LinearLayout>
</FrameLayout>
