    <string name="development_release_optimization">Release 优化</string>
    <string name="development_release_optimization_value">代码压缩 + 资源收缩</string>
    <string name="development_build_body">模块使用 compileSdk 37、targetSdk 36 和 minSdk 24 构建。Release 构建通过项目配置的 Android/ProGuard 工具启用代码压缩与资源收缩。</string>
    <string name="development_ui_section">界面与渲染</string>
    <string name="development_ui_body">界面使用 Jetpack Compose 与 Material 3。应用采用 edge-to-edge 沉浸式显示，并通过 Compose/Choreographer 的标准管线与 VSYNC 同步渲染。</string>
    <string name="development_architecture_section">架构</string>
    <string name="development_architecture_body">主 Activity 负责 Compose 导航。ViewModel 暴露状态与操作，Repository 集中处理持久化和数据逻辑，Room 管理笔记与附件，DataStore 保存应用设置。</string>
    <string name="development_storage_section">数据与存储</string>
    <string name="development_storage_body">笔记通过 Room 保存在本地。附件保存在应用私有存储中，缩略图使用缓存以避免滚动时重复解码大型文件。Android 清理缓存后，应用可从原始文件重新生成。</string>
    <string name="development_media_section">媒体与预览</string>
    <string name="development_media_body">Coil 3 处理图片与远程资源，Media3/ExoPlayer 播放视频和音频，AttachmentPreviewCache 生成并复用图片、视频、专辑封面和 PDF 首页预览。链接预览单独处理以避免阻塞界面。</string>
    <string name="development_performance_section">性能配置</string>
    <string name="development_performance_intro">设置中选择的模式同时控制首选屏幕刷新率和缓存缩略图分辨率。</string>
    <string name="development_profile_performance">最高性能</string>
    <string name="development_profile_performance_detail">60 Hz。图片和视频最高 360 px，音频封面 256 px，PDF 480 px。优先降低 CPU、内存和解码负载。</string>
    <string name="development_profile_balanced">均衡</string>
    <string name="development_profile_balanced_detail">60 Hz。图片和视频最高 720 px，音频封面 512 px，PDF 960 px。在清晰度和资源占用之间保持平衡。</string>
    <string name="development_profile_quality">最高质量</string>
    <string name="development_profile_quality_detail">设备支持时最高 120 Hz。图片 1280 px、视频 1080 px、音频封面 768 px、PDF 1440 px。优先视觉质量。</string>
    <string name="development_current_profile">当前</string>
    <string name="development_stack_section">主要技术</string>
    <string name="development_stack_body">Kotlin、Jetpack Compose、Material 3、Room 2.7.2 + KSP、DataStore Preferences 1.1.7、Coil 3.3.0、Media3/ExoPlayer 1.11.0、Lifecycle Runtime Compose 2.11.0、AppCompat 1.7.1 与 Kotlin 协程。项目使用 Java 11 兼容配置。</string>
    <string name="development_compatibility_section">兼容性与设计</string>
    <string name="development_compatibility_body">MyNotes 从 Android 7.0/API 24 起运行，并针对旧设备调整部分性能策略。刷新率只是向系统提出的首选请求，屏幕或合成器无法提供精确频率时 Android 可能选择其他模式。</string>

    <string name="development_android_integration_section">Android 集成</string>
    <string name="development_android_integration_body">应用声明 Internet 权限用于远程预览，录音权限用于语音笔记，振动权限用于触觉反馈。麦克风硬件被声明为可选。FileProvider 用于安全共享文件，ACTION_SEND 允许 MyNotes 从其他应用分享的文本创建笔记。</string>

