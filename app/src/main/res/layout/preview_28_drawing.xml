<?xml version="1.0" encoding="utf-8"?>
<!-- Vistas Android editables. Referencia de diseño: Compose; mapa en doc/layout_compose_previews.json. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/layout_xml_screen"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="18dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    tools:ignore="HardcodedText,ContentDescription"
    android:theme="@style/LayoutXmlPreviewTheme"
    tools:context="com.example.mynotes.MainActivity"
    android:id="@+id/preview_28_drawing_linearlayout_0">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/preview_28_drawing_linearlayout_1">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/preview_ic_arrow_back"
            android:tint="@color/layout_xml_text"
            android:id="@+id/preview_28_drawing_imageview_2" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:id="@+id/preview_28_drawing_linearlayout_3">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/drawing_title"
                android:textColor="@color/layout_xml_text"
                android:textSize="22sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_28_drawing_textview_4" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/drawing_subtitle"
                android:textColor="@color/layout_xml_text"
                android:textSize="11sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_28_drawing_textview_5" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/preview_button_light"
            android:id="@+id/preview_28_drawing_framelayout_6">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/preview_ic_check"
                android:tint="@color/layout_xml_text"
                android:id="@+id/preview_28_drawing_imageview_7" />
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group"
        android:id="@+id/preview_28_drawing_framelayout_8">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="✎     ~~~~~\n        ~~~~~~~~\n  ~~~~~"
            android:textColor="@color/layout_xml_text"
            android:textSize="30sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_28_drawing_textview_9" />
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/preview_button_light"
            android:id="@+id/preview_28_drawing_framelayout_10">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⛶"
                android:textColor="@color/layout_xml_text"
                android:textSize="24sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="true"
                android:id="@+id/preview_28_drawing_textview_11" />
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/preview_light_group"
        android:orientation="vertical"
        android:padding="10dp"
        android:id="@+id/preview_28_drawing_linearlayout_12">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/drawing_tools"
            android:textColor="@color/layout_xml_text"
            android:textSize="12sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_28_drawing_textview_13" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:scrollbars="none"
            android:id="@+id/preview_28_drawing_horizontalscrollview_14">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/preview_28_drawing_linearlayout_15">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/preview_small_selected"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/drawing_tool_pen"
                    android:textColor="@color/layout_xml_text"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_28_drawing_textview_16" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/preview_small_unselected"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/drawing_tool_highlighter"
                    android:textColor="@color/layout_xml_text"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_28_drawing_textview_17" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/preview_small_unselected"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/drawing_tool_marker"
                    android:textColor="@color/layout_xml_text"
                    android:includeFontPadding="true"
                    android:id="@+id/preview_28_drawing_textview_18" />
            </LinearLayout>
        </HorizontalScrollView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="@string/drawing_colors"
            android:textColor="@color/layout_xml_text"
            android:textSize="12sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_28_drawing_textview_19" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/preview_28_drawing_linearlayout_20">
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/preview_dot_gray"
                android:id="@+id/preview_28_drawing_view_21" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_dot_cyan"
                android:id="@+id/preview_28_drawing_view_22" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_dot_orange"
                android:id="@+id/preview_28_drawing_view_23" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_dot_lime"
                android:id="@+id/preview_28_drawing_view_24" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_dot_lav2"
                android:id="@+id/preview_28_drawing_view_25" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_dot_neon_pink"
                android:id="@+id/preview_28_drawing_view_26" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif"
            android:text="@string/drawing_canvas_color"
            android:textColor="@color/layout_xml_text"
            android:textSize="12sp"
            android:includeFontPadding="true"
            android:id="@+id/preview_28_drawing_textview_27" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/preview_28_drawing_linearlayout_28">
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/preview_circle_selected"
                android:backgroundTint="#FFFFFF"
                android:id="@+id/preview_28_drawing_view_29" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_circle_base"
                android:backgroundTint="#FFF4C7"
                android:id="@+id/preview_28_drawing_view_30" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_circle_base"
                android:backgroundTint="#FFE5EC"
                android:id="@+id/preview_28_drawing_view_31" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_circle_base"
                android:backgroundTint="#DFF7EA"
                android:id="@+id/preview_28_drawing_view_32" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_circle_base"
                android:backgroundTint="#34384A"
                android:id="@+id/preview_28_drawing_view_33" />
            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/preview_circle_base"
                android:backgroundTint="#111111"
                android:id="@+id/preview_28_drawing_view_34" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/preview_28_drawing_linearlayout_35">
            <TextView
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/drawing_thickness"
                android:textColor="@color/layout_xml_text"
                android:textSize="12sp"
                android:includeFontPadding="true"
                android:id="@+id/preview_28_drawing_textview_36" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/preview_small_selected"
                android:gravity="center"
                android:fontFamily="sans-serif"
                android:text="@string/drawing_thin"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_28_drawing_textview_37" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:fontFamily="sans-serif"
                android:text="@string/drawing_medium"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_28_drawing_textview_38" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/preview_small_unselected"
                android:gravity="center"
                android:fontFamily="sans-serif"
                android:text="@string/drawing_thick"
                android:textColor="@color/layout_xml_text"
                android:includeFontPadding="true"
                android:id="@+id/preview_28_drawing_textview_39" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
