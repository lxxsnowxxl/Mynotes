<?xml version="1.0" encoding="utf-8"?>
<!-- v312: editable design reference; production screen is implemented in Compose. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_xml_app_background"
    android:theme="@style/LayoutXmlPreviewTheme"
    android:padding="16dp">
    <include
        layout="@layout/preview_04_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_gravity="center"
        android:background="@drawable/layout_xml_tone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_live_preview"
            android:textSize="22sp"
            android:textColor="@color/layout_xml_text"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:clipChildren="true">
            <FrameLayout
                android:layout_width="360dp"
                android:layout_height="640dp"
                android:scaleX="0.45"
                android:scaleY="0.45"
                android:transformPivotX="0dp"
                android:transformPivotY="0dp">
                <include
                    layout="@layout/preview_01_notes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </FrameLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_preview_font"
            android:textSize="14sp"
            android:textColor="@color/layout_xml_text" />
        <SeekBar
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/layout_xml_slider_progress"
            android:thumb="@drawable/layout_xml_slider_thumb"
            android:thumbOffset="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:splitTrack="false"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/organize_preview_corners"
            android:textSize="14sp"
            android:textColor="@color/layout_xml_text" />
        <SeekBar
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/layout_xml_slider_progress"
            android:thumb="@drawable/layout_xml_slider_thumb"
            android:thumbOffset="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:splitTrack="false"/>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_apply"
            android:minHeight="48dp" />
    </LinearLayout>
</FrameLayout>
